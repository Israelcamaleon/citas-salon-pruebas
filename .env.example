# Plantilla — copiar a .env.local (local) o pegar en Vercel → Settings → Environment Variables
#
# Prisma CLI (migrate) lee .env en la raíz, NO .env.local.
# Opción A: copiar también DATABASE_URL y DIRECT_URL a .env
# Opción B: npm run db:migrate (carga .env.local automáticamente)

PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://ypwzuxrtlsqaojdjxrdd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler (5432) — migraciones Prisma locales
DIRECT_URL="postgresql://postgres.ypwzuxrtlsqaojdjxrdd:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Transaction pooler (6543) — runtime en Vercel (obligatoria)
DATABASE_URL="postgresql://postgres.ypwzuxrtlsqaojdjxrdd:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=logos

# Módulo de lealtad (submódulo opcional por despliegue)

# En Vercel también define (después del primer deploy):
# NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# NO pongas NODE_ENV en Vercel — lo asigna automáticamente (production)
