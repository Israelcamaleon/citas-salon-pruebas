generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  durationMin Int
  priceMXN    Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Staff {
  id                  Int                  @id @default(autoincrement())
  name                String
  roleId              Int
  email               String               @unique
  phone               String?
  authUserId          String?              @unique
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  role                Role                 @relation(fields: [roleId], references: [id])
  bookings            Booking[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([roleId])
}

model Location {
  id        Int                @id @default(autoincrement())
  name      String
  address   String
  phone     String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  bookings  Booking[]
  schedule  LocationSchedule?
}

model Customer {
  id              Int                @id @default(autoincrement())
  name            String
  phone           String?
  email           String?
  notes           String?
  sexo            String?            // mujer | hombre | otro
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bookings        Booking[]
  loyaltyCards    LoyaltyCard[]
  loyaltyCouponUses LoyaltyCouponUse[]
  ficha           CustomerFicha?
  hairRecords     HairServiceRecord[]
  posTickets      PosTicket[]
  leads           Lead[]
}

// ─── Ficha de diagnóstico capilar ───────────────────────────────────────────

model CustomerFicha {
  id                 Int       @id @default(autoincrement())
  customerId         Int       @unique
  // Alertas / datos fijos
  alergiasTiene      Boolean   @default(false)
  alergiasDetalle    String?
  pruebaAlergiaHasta DateTime?
  embarazoLactancia  Boolean   @default(false)
  tipoCabello        String?   // liso | ondulado | rizado | afro
  grosor             String?   // fino | medio | grueso
  alertas            Json?     // string[] de alertas permanentes
  // Color actual
  nivelBase          Int?      // 1-10
  subtono            String?
  porcentajeCanas    Int?      // 0-100
  colorHex           String?
  // Estado del cabello (0-100)
  elasticidad        Int?
  porosidad          Int?
  hidratacion        Int?
  // Cuidados post-servicio vigentes
  cuidados           String?
  notasCuidados      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model HairServiceRecord {
  id            Int       @id @default(autoincrement())
  customerId    Int
  fecha         DateTime  @default(now())
  servicio      String
  formula       Json?     // { raiz, longitudes, puntas, tonalizacion } cada zona { producto, oxidante, tiempo }
  resultado     String?
  nivelDano     Int?      // 1-5
  fotos         Json?     // string[] urls
  mapaTecnica   Json?     // [{ color, strokeWidth, pathData }]
  cuidados      String?
  observaciones String?
  createdAt     DateTime  @default(now())
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Booking {
  id          Int      @id @default(autoincrement())
  date        DateTime
  durationMin Int
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceId  Int
  staffId    Int
  locationId Int
  customerId Int

  service  Service  @relation(fields: [serviceId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([locationId, date])
  @@index([staffId, date])
  @@index([date])
}

model AppSettings {
  id           Int      @id @default(1)
  businessName String   @default("")
  address      String   @default("")
  logoUrl      String?
  updatedAt    DateTime @updatedAt
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff[]
}

model LocationSchedule {
  id         Int      @id @default(autoincrement())
  locationId Int      @unique
  schedule   Json
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

// ─── Loyalty submodule ───────────────────────────────────────────────────────

enum LoyaltyProgramType {
  STAMP
  DISCOUNT
  GIFT
  COUPON
  PREPAID
  CASHBACK
  SERVICE
}

enum LoyaltyCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  BLOCKED
}

enum LoyaltyTransactionType {
  STAMP
  REDEEM
  LOAD
  DISCOUNT_APPLY
  COUPON_USE
  CASHBACK_EARN
  CASHBACK_REDEEM
  SERVICE_USE
}

model LoyaltyProgram {
  id          Int                @id @default(autoincrement())
  name        String
  type        LoyaltyProgramType
  description String?
  config      Json
  color       String             @default("#378ADD")
  logoUrl     String?
  bgUrl       String?
  active      Boolean            @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cards       LoyaltyCard[]
  couponUses  LoyaltyCouponUse[]
}

model LoyaltyCard {
  id           Int                @id @default(autoincrement())
  balance      Int                @default(0)
  status       LoyaltyCardStatus  @default(ACTIVE)
  serviceUsage Json?
  issuedAt     DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customerId Int
  programId  Int
  customer   Customer             @relation(fields: [customerId], references: [id])
  program    LoyaltyProgram       @relation(fields: [programId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@index([programId])
  @@unique([customerId, programId])
}

model LoyaltyTransaction {
  id          Int                    @id @default(autoincrement())
  type        LoyaltyTransactionType
  amount      Int                    @default(0)
  purchaseAmt Int?
  notes       String?
  createdAt   DateTime               @default(now())

  cardId  Int
  staffId Int?
  card    LoyaltyCard @relation(fields: [cardId], references: [id])
  staff   Staff?      @relation(fields: [staffId], references: [id])

  @@index([cardId])
  @@index([createdAt])
}

model LoyaltyCouponUse {
  id        Int            @id @default(autoincrement())
  usedCount Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  programId  Int
  customerId Int
  program    LoyaltyProgram @relation(fields: [programId], references: [id])
  customer   Customer       @relation(fields: [customerId], references: [id])

  @@unique([programId, customerId])
}

// ─── Integración Odoo 8 + Meta Ads (marketing / ROAS) ───────────────────────
// Reglas de negocio verificadas contra el Odoo real el 10-ago-2026.
// Ver src/lib/odoo/sync.ts

model PosTicket {
  id            Int       @id @default(autoincrement())
  odooId        Int       @unique // pos.order id — cursor de sincronización incremental
  folio         String    // ej. "Juruquilla/26293" (NO único global; Juriquilla viene mal escrito así)
  dateUtc       DateTime  // date_order crudo de Odoo (UTC)
  dayLocal      String    // YYYY-MM-DD hora Querétaro (UTC−6) — USAR para ROAS diario
  amountTotal   Float     // con IVA 16%, MXN
  branch        String    // "Zaragoza" | "Juriquilla" | "Heeler Studio" | "Terranova"
  attributable  Boolean   // false si fue "venta mostrador" (partner genérico 18529) o sin teléfono
  customerPhone String?   // 10 dígitos normalizados — llave de atribución
  odooPartnerId Int?      // res.partner id en Odoo

  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id])

  lines         PosTicketLine[]

  @@index([dayLocal])
  @@index([branch, dayLocal])
  @@index([customerId])
  @@index([customerPhone])
}

model PosTicketLine {
  id            Int       @id @default(autoincrement())
  odooId        Int       @unique // pos.order.line id
  productOdooId Int
  productName   String
  qty           Float
  amountIncl    Float     // price_subtotal_incl (con IVA)
  businessLine  String    // "Alika" | "Cattledogs" | "Heeler Studio" (categoría POS raíz)

  ticketId      Int
  ticket        PosTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([businessLine])
}

// Cursor de la sincronización incremental (los tickets no se editan tras cobrarse)
model SyncState {
  id         String    @id // "odoo" | "meta"
  lastOdooId Int       @default(0)
  lastRunAt  DateTime  @default(now())
  lastOkAt   DateTime?
  lastError  String?
}

// ─── Meta Ads ───

model AdCampaign {
  id        String   @id @default(cuid())
  metaId    String   @unique // campaign id de Meta
  name      String
  status    String
  objective String?

  daily     AdInsightDaily[]
}

model AdInsightDaily {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD (zona horaria de la ad account)
  spend       Float    // MXN
  impressions Int
  clicks      Int
  reach       Int

  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
}

// ─── Atribución ───

enum LeadSource {
  META_AD
  WHATSAPP_ORGANIC
  DIRECT
  UNKNOWN
}

model Lead {
  id             String     @id @default(cuid())
  source         LeadSource @default(UNKNOWN)
  metaCampaignId String?    // campaign id de Meta si vino de anuncio
  firstMessageAt DateTime?
  attributedBy   String?    // "meta-webhook" | "time-window" | "keyword"

  customerId     Int?
  customer       Customer?  @relation(fields: [customerId], references: [id])

  createdAt      DateTime   @default(now())

  @@index([customerId])
  @@index([metaCampaignId])
}
