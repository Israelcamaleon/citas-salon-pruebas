# ── LoyaltyHub .env ──────────────────────────────────
# Copia este archivo como .env y ajusta los valores

# Base de datos (tu MySQL/MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASS=tu_password
DB_NAME=loyaltyhub

# JWT — cambia esto por una cadena aleatoria larga
JWT_SECRET=cambia_esto_por_algo_muy_secreto_32chars

# URLs
PORT=3001
FRONTEND_URL=https://tu-dominio.com
CLIENT_URL=https://tu-dominio.com/cliente

# PassKit (para Apple/Google Wallet) — obtener en passkit.com
PASSKIT_API_KEY=
PASSKIT_PASS_TYPE_ID=

# Opcional: conexión a tu agenda si está en otra DB
# AGENDA_DB_HOST=localhost
# AGENDA_DB_USER=root
# AGENDA_DB_PASS=
# AGENDA_DB_NAME=tu_agenda
